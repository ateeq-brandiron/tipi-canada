# Copy to .env.local for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# --- Site -------------------------------------------------------------------
# Canonical URL (used for metadata, sitemap, robots, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://tipicanada.com

# --- Feature flags ----------------------------------------------------------
# Show "The Investment" section + nav link. Keep false until the client approves the ask.
NEXT_PUBLIC_SHOW_INVESTMENT_ASK=false
# Show "[Pending confirmation]" badges and photo-placeholder notes. Set false for launch.
NEXT_PUBLIC_SHOW_REVIEW_NOTES=true

# --- Analytics & Search Console ---------------------------------------------
# GA4 measurement ID. Leave empty to load no analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console "HTML tag" verification token (the content="…" value only).
GOOGLE_SITE_VERIFICATION=

# --- Contact form email delivery ---------------------------------------------
# "log" (default): no email sent, inquiry metadata logged server-side.
# "resend": send via Resend (requires the three values below).
EMAIL_PROVIDER=log
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
